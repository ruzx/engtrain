   ]
  },
  {
   "rule": "**at the end / beginning of** something = at the moment it ends / starts.",
   "examples": [
    "I'm going away at the end of May."
   ]
  },
  {
   "rule": "**in the end** = finally, after a long time.",
   "examples": [
    "In the end, we sold the car."
   ]
  }
