{
 "id": "prep-verb",
 "title": "Prepositions after verbs",
 "summary": "look at, listen to, depend on, think about",
 "rules": [
  {
   "rule": "**at**: *look / stare / glance / laugh / point / shout (angrily) / throw (to hit) at*.",
   "examples": [
    "Look at her!",
    "Don't shout at me!"
   ]
  },
  {
   "rule": "**to**: *listen / talk / write / explain / describe (something) to someone, invite to, throw (to catch) to*.",
   "examples": [
    "Explain it to me, please.",
    "I listened to the radio."
   ]
  },
  {
   "rule": "**No preposition**: *phone / call someone, discuss something, ask someone, I'm sorry (that)…*",
   "examples": [
    "We discussed the plan.",
    "Call me tomorrow."
   ]
  },
  {
   "rule": "**about / of**: *talk / care / dream / hear / think / complain / warn about*; *dream / hear / think of*; *remind of* (= similar), *remind about* (= don't forget).",
   "examples": [
    "This photo reminds me of my home town.",
    "I don't care about money."
   ]
  },
  {
   "rule": "**for**: *look / ask / apply / pay / thank / blame for*; **on**: *depend / rely / live / concentrate / insist / spend money on*; **of**: *accuse / suspect / consist / die of*; **in**: *believe / specialise / succeed in*; **into**: *break / crash / cut / translate into*; **from**: *suffer / protect from*.",
   "examples": [
    "It depends on the weather.",
    "I believe in you."
   ]
  }
 ],
