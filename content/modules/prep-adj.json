 "summary": "afraid of, good at, interested in",
 "rules": [
  {
   "rule": "**It's kind / nice / silly of you** (to do something). **kind / friendly to** someone.",
   "examples": [
    "It was kind of you to help me.",
    "She was always kind to me."
   ]
  },
  {
   "rule": "**angry / annoyed / upset about** something, **angry with** a person. **excited / worried / nervous about**.",
   "examples": [
    "I'm angry with her for being late.",
    "I'm nervous about the exam."
   ]
  },
  {
   "rule": "**pleased / satisfied / disappointed with**; **surprised / shocked at / by**; **fed up / bored with**.",
   "examples": [
    "I'm pleased with my new phone."
   ]
  },
  {
   "rule": "**of**: *afraid, scared, proud, ashamed, jealous, aware, capable, full, tired, sure, typical, independent of*.",
   "examples": [
    "I'm afraid of spiders.",
    "The bottle is full of water."
   ]
  },
  {
   "rule": "**good / bad at**; **interested in**; **keen on, dependent on**; **married / similar to**; **different from / to**; **famous / responsible for**; **sorry for / about**.",
   "examples": [
    "I'm good at maths.",
