{
 "id": "articles",
 "title": "Articles: a, an, the",
 "summary": "When to use a/an, the or no article",
 "rules": [
  {
   "rule": "**a / an** — one thing, not specific; jobs: *She is a doctor.*",
   "examples": [
    "I have an apple.",
    "He is an engineer."
   ]
  },
  {
   "rule": "**an** before a vowel **sound**: *an hour, an umbrella* — but *a university, a user* (they start with a /j/ sound).",
   "examples": [
    "I waited for an hour.",
    "She studies at a university."
   ]
  },
  {
   "rule": "**the** — both people know which one: mentioned before, or only one exists.",
   "examples": [
    "I bought apples. The apples were sweet.",
    "The sun is hot."
   ]
  },
  {
   "rule": "**No article** — plural or uncountable things in general; and in *go to bed, at work, go home, at school* (as a student).",
   "examples": [
    "I like children.",
    "She is at work.",
    "Let's go home."
   ]
  },
  {
   "rule": "Countries: usually **no article** (*Spain, Russia*), but **the** with *Republic, Kingdom, States*: *the US, the UK, the Czech Republic*.",
   "examples": [
    "I live in Spain.",
    "I'm from the US."
   ]
  }
 ],
