{
 "id": "prep-place",
 "title": "Prepositions of place",
 "summary": "at the bus stop, in the garden, on the wall",
 "rules": [
  {
   "rule": "**at** — a point or a place where something happens: *at the bus stop, at the door, at the top, at work, at school, at home*.",
   "examples": [
    "We waited at the bus stop.",
    "She is at work."
   ]
  },
  {
   "rule": "**in** — inside an area or space: *in the garden, in my pocket, in a car, in Moscow, in bed, in the sky*.",
   "examples": [
    "The money is in my wallet.",
    "They are in the car."
   ]
  },
  {
   "rule": "**on** — on a surface or line: *on the wall, on the floor, on a page, on the radio, on TV, on a bus / train / plane / bike*.",
   "examples": [
    "There is a picture on the wall.",
    "I heard it on the radio."
   ]
  },
  {
   "rule": "**by** + transport with no article: *by bus, by car, by train*. But **in** a car / taxi, **on** a bus / train / horse.",
   "examples": [
    "We came by train.",
    "She arrived in a taxi."
   ]
  }
 ],
