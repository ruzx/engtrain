{
 "id": "prep-movement",
 "title": "To, at, in, into",
 "summary": "go to, arrive at / in, get into",
 "rules": [
  {
   "rule": "**go / come / travel to** a place: *go to Rome, go to a party, go to bed*.",
   "examples": [
    "I'm going to a concert tonight."
   ]
  },
  {
   "rule": "**been to** = visited: *I've been to Italy.*",
   "examples": [
    "I've never been to Rome."
   ]
  },
  {
   "rule": "**arrive in** a city or country, **arrive at** other places: *arrive in Madrid, arrive at the hotel*.",
   "examples": [
    "We arrived in Spain on Monday.",
    "We arrived at the hotel late."
   ]
  },
  {
   "rule": "**home** — no preposition after *go, come, get, arrive*; but **at home**.",
   "examples": [
    "Let's go home.",
    "Stay at home today."
   ]
  },
  {
   "rule": "**into** = movement inside; **out of** = movement outside; **get on / off** a bus, train, plane.",
   "examples": [
    "He got into the car.",
    "She got off the bus."
   ]
  }
 ],
