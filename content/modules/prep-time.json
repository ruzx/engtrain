{
 "id": "prep-time",
 "title": "Prepositions of time",
 "summary": "at 5 o'clock, on Monday, in May",
 "rules": [
  {
   "rule": "**at** + clock time and points: *at 5 o'clock, at noon, at night, at the weekend (UK), at Christmas, at the moment*.",
   "examples": [
    "We have tea at 5 o'clock.",
    "Stars shine at night."
   ]
  },
  {
   "rule": "**on** + days and dates: *on Monday, on Friday evenings, on 6 June, on my birthday, on Christmas Day*.",
   "examples": [
    "We play cards on Friday evenings.",
    "Pushkin was born on 6 June 1799."
   ]
  },
  {
   "rule": "**in** + longer periods: *in May, in summer, in 2010, in the 19th century, in the morning, in the future*.",
   "examples": [
    "We got married in June.",
    "I usually run in the morning."
   ]
  },
  {
   "rule": "**No preposition** before *last, next, this, every, yesterday, tomorrow*.",
   "examples": [
    "I saw her last week.",
    "We will finish it next year."
   ]
  }
 ],
